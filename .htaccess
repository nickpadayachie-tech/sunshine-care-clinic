Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://www.sunshinehealthcare.co.za/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} !^www\.sunshinehealthcare\.co\.za$ [NC]
  RewriteRule ^(.*)$ https://www.sunshinehealthcare.co.za/$1 [R=301,L]

  RewriteRule ^about\.html$ /about/ [R=301,L]
  RewriteRule ^services\.html$ /services/ [R=301,L]
  RewriteRule ^iv-drip-therapy\.html$ /iv-drip-therapy/ [R=301,L]
  RewriteRule ^family-baby-wellness\.html$ /family-baby-wellness/ [R=301,L]
  RewriteRule ^wound-care\.html$ /wound-care/ [R=301,L]
  RewriteRule ^contact\.html$ /contact/ [R=301,L]

  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^services/?$ services.html [L]
  RewriteRule ^iv-drip-therapy/?$ iv-drip-therapy.html [L]
  RewriteRule ^family-baby-wellness/?$ family-baby-wellness.html [L]
  RewriteRule ^wound-care/?$ wound-care.html [L]
  RewriteRule ^contact/?$ contact.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>